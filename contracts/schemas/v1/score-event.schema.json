{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noncelogic.github.io/corpus-ranker/schemas/v1/score-event.schema.json",
  "title": "Score event (SPEC A2.7)",
  "description": "One append-only evaluation of one Item under one Policy version. Invalidated only by a retraction recorded on it.",
  "type": "object",
  "required": ["id", "item_id", "policy_id", "policy_version", "dimension_scores", "scorer", "scored_at", "source_blind", "retracted_at", "retracted_by", "retraction_reason"],
  "additionalProperties": false,
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/score_event_id" },
    "item_id": { "$ref": "common.schema.json#/$defs/item_id" },
    "policy_id": { "$ref": "common.schema.json#/$defs/policy_id" },
    "policy_version": { "$ref": "common.schema.json#/$defs/policy_version" },
    "dimension_scores": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/dimension_score" } },
    "scorer": { "$ref": "#/$defs/scorer" },
    "scored_at": { "$ref": "common.schema.json#/$defs/timestamp" },
    "source_blind": { "type": "boolean", "description": "As actually run." },
    "retracted_at": { "$ref": "common.schema.json#/$defs/nullable_timestamp" },
    "retracted_by": { "anyOf": [{ "$ref": "common.schema.json#/$defs/agent_identity" }, { "type": "null" }] },
    "retraction_reason": { "type": ["string", "null"] }
  },
  "anyOf": [
    { "properties": { "retracted_at": { "type": "null" }, "retracted_by": { "type": "null" }, "retraction_reason": { "type": "null" } } },
    { "properties": { "retracted_at": { "type": "string" }, "retracted_by": { "type": "string" }, "retraction_reason": { "type": "string", "minLength": 1 } } }
  ],
  "$defs": {
    "dimension_score": {
      "type": "object",
      "required": ["dimension", "value", "reason", "evidence"],
      "additionalProperties": false,
      "properties": {
        "dimension": { "type": "string", "minLength": 1 },
        "value": { "type": "number" },
        "reason": { "type": "string", "minLength": 1, "description": "Required: the why." },
        "evidence": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/evidence_ref" } }
      }
    },
    "scorer": {
      "type": "object",
      "required": ["identity"],
      "additionalProperties": false,
      "properties": {
        "identity": { "$ref": "common.schema.json#/$defs/agent_identity" },
        "model": { "type": "string", "minLength": 1 },
        "config": { "type": "object" }
      }
    }
  }
}

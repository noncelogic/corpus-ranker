{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noncelogic.github.io/corpus-ranker/schemas/v1/tombstone.schema.json",
  "title": "Tombstone (SPEC A2.9)",
  "description": "Record of verified forgetting: content is destroyed, the hash, provenance and reason are kept; dependent Items are tombstoned and dependent views go stale.",
  "type": "object",
  "required": ["id", "target_id", "reason", "actor", "tombstoned_at", "preserved", "tombstoned_item_ids", "stale_view_ids"],
  "additionalProperties": false,
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/tombstone_id" },
    "target_id": { "type": "string", "pattern": "^cr_(orig|item)_[A-Za-z0-9]+$" },
    "reason": { "type": "string", "minLength": 1 },
    "actor": { "$ref": "common.schema.json#/$defs/agent_identity" },
    "tombstoned_at": { "$ref": "common.schema.json#/$defs/timestamp" },
    "preserved": {
      "type": "array",
      "description": "What survives for each forgotten Original: the content hash and its provenance.",
      "items": {
        "type": "object",
        "required": ["original_id", "content_hash", "source"],
        "additionalProperties": false,
        "properties": {
          "original_id": { "$ref": "common.schema.json#/$defs/original_id" },
          "content_hash": { "$ref": "common.schema.json#/$defs/sha256" },
          "source": { "$ref": "common.schema.json#/$defs/provenance" }
        }
      }
    },
    "tombstoned_item_ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/item_id" } },
    "stale_view_ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/view_id" } }
  }
}
